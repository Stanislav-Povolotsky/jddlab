{
  "server": {
    "name": "jddlab-mcp",
    "version": "0.1.0",
    "transport": "stdio",
    "entrypoint": "python mcp/server.py",
    "docker_image": "stanislavpovolotsky/jddlab:latest"
  },
  "execution": {
    "template": "docker run --rm -v \"<host-mount-root>:/work\" stanislavpovolotsky/jddlab:latest <command> <args>",
    "mount_root_strategy": "Infer a common host directory from workdir, input_paths, and output_paths. Rewrite host path arguments under that directory to /work-relative paths before invoking Docker.",
    "notes": [
      "Set interactive=true only for clients that can handle TTY commands.",
      "Use extra_mounts for ADB keys, Frida files, Android keystores, or other host-side state.",
      "Use each command's markdown file in tools/ for mode and argument guidance."
    ]
  },
  "tools": [
    {"command": "APKEditor", "mcp_tool": "jddlab_APKEditor", "docs": "tools/APKEditor.md"},
    {"command": "androguard", "mcp_tool": "jddlab_androguard", "docs": "tools/androguard.md"},
    {"command": "android-unpinner", "mcp_tool": "jddlab_android_unpinner", "docs": "tools/android-unpinner.md"},
    {"command": "apk-patcher", "mcp_tool": "jddlab_apk_patcher", "docs": "tools/apk-patcher.md"},
    {"command": "apk-sign", "mcp_tool": "jddlab_apk_sign", "docs": "tools/apk-sign.md"},
    {"command": "apkeditor", "mcp_tool": "jddlab_apkeditor", "docs": "tools/APKEditor.md"},
    {"command": "apktool", "mcp_tool": "jddlab_apktool", "docs": "tools/apktool.md"},
    {"command": "asm-verify", "mcp_tool": "jddlab_asm_verify", "docs": "tools/asm-verify.md"},
    {"command": "baksmali", "mcp_tool": "jddlab_baksmali", "docs": "tools/baksmali.md"},
    {"command": "class-version-switch", "mcp_tool": "jddlab_class_version_switch", "docs": "tools/class-version-switch.md"},
    {"command": "d2j-apk-sign", "mcp_tool": "jddlab_d2j_apk_sign", "docs": "tools/d2j-apk-sign.md"},
    {"command": "d2j-asm-verify", "mcp_tool": "jddlab_d2j_asm_verify", "docs": "tools/d2j-asm-verify.md"},
    {"command": "d2j-baksmali", "mcp_tool": "jddlab_d2j_baksmali", "docs": "tools/d2j-baksmali.md"},
    {"command": "d2j-class-version-switch", "mcp_tool": "jddlab_d2j_class_version_switch", "docs": "tools/d2j-class-version-switch.md"},
    {"command": "d2j-decrypt-string", "mcp_tool": "jddlab_d2j_decrypt_string", "docs": "tools/d2j-decrypt-string.md"},
    {"command": "d2j-dex-recompute-checksum", "mcp_tool": "jddlab_d2j_dex_recompute_checksum", "docs": "tools/d2j-dex-recompute-checksum.md"},
    {"command": "d2j-dex-weaver", "mcp_tool": "jddlab_d2j_dex_weaver", "docs": "tools/d2j-dex-weaver.md"},
    {"command": "d2j-dex2jar", "mcp_tool": "jddlab_d2j_dex2jar", "docs": "tools/d2j-dex2jar.md"},
    {"command": "d2j-dex2smali", "mcp_tool": "jddlab_d2j_dex2smali", "docs": "tools/d2j-dex2smali.md"},
    {"command": "d2j-jar-access", "mcp_tool": "jddlab_d2j_jar_access", "docs": "tools/d2j-jar-access.md"},
    {"command": "d2j-jar-weaver", "mcp_tool": "jddlab_d2j_jar_weaver", "docs": "tools/d2j-jar-weaver.md"},
    {"command": "d2j-jar2dex", "mcp_tool": "jddlab_d2j_jar2dex", "docs": "tools/d2j-jar2dex.md"},

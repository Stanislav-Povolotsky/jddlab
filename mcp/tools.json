    {"command": "std-apk", "mcp_tool": "jddlab_std_apk", "docs": "tools/std-apk.md"},
    {"command": "vineflower", "mcp_tool": "jddlab_vineflower", "docs": "tools/vineflower.md"}
  ]
}


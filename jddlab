#!/usr/bin/env sh
# jddlab - thin launcher.
#
# Its only job: make sure the REAL launcher (shipped inside the Docker image) is present
# under ~/.jddlab/mcp/current, then hand over to it. Download this once - it rarely
# changes. All real functionality (running tools, MCP, skills, help, ...) lives in the
# image and is updated together with it via `jddlab update`.
jddlab_image="stanislavpovolotsky/jddlab:latest"
jddlab_home=${JDDLAB_MCP_HOME:-"$HOME/.jddlab/mcp"}
jddlab_real="$jddlab_home/current/jddlab"

# Copy /usr/local/jddlab/host out of the image into ~/.jddlab/mcp/current with
# `docker cp` (files owned by the host user). `docker create` auto-pulls the image if
# it is not present locally. $1=1 forces re-extraction. Returns 0 on success.
jddlab_extract() {
  if [ "$1" != "1" ] && [ -f "$jddlab_real" ]; then
    return 0
  fi
  echo "Fetching jddlab from the image..." >&2
  jddlab_cid=$(docker create "$jddlab_image") || return 1
  jddlab_tmp="$jddlab_home/current.new"
  rm -rf "$jddlab_tmp"
  mkdir -p "$jddlab_tmp"
  if docker cp "$jddlab_cid:/usr/local/jddlab/host/." "$jddlab_tmp"; then
    docker rm "$jddlab_cid" >/dev/null 2>&1
    rm -rf "$jddlab_home/current"
    mv "$jddlab_tmp" "$jddlab_home/current"
    return 0
  fi
  docker rm "$jddlab_cid" >/dev/null 2>&1
  rm -rf "$jddlab_tmp"
  return 1
}

# `jddlab update`: pull the newest image and re-extract everything (launcher + MCP +
# skills + tools). Owned by the thin launcher because it runs from a stable path and
# can safely replace ~/.jddlab/mcp/current.
if [ "$#" -eq 1 ] && [ "$1" = "update" ]; then
  echo "Updating jddlab..."
  docker pull "$jddlab_image"
  jddlab_update_rc=$?
  jddlab_extract 1 || echo "Could not re-extract jddlab from the image." >&2
  exit $jddlab_update_rc
fi

if [ ! -f "$jddlab_real" ]; then
  if ! jddlab_extract 0; then
    echo "jddlab: could not fetch the launcher from the image. Is Docker running? Try 'jddlab update'." >&2
    exit 1
  fi
fi

exec sh "$jddlab_real" "$@"
